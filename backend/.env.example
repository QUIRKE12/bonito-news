# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bonito?appName=Cluster0

# Custom JWT auth (replaces Firebase Authentication)
# Generate strong random values, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary — signed direct uploads (see backend/src/config/cloudinary.ts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000

# Server port (Render sets this automatically in production)
PORT=4000
